# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Android Studio / IntelliJ
*.iml
.idea/
local.properties
# AGP's default `captures/` output is gitignored; we don't use AGP's
# screenshot test infrastructure so this stays. (Removed from the M0
# .gitignore so app/src/main/java/com/baton/app/data/captures/ can
# be tracked.)
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.aar
*.dex
*.class

# Kotlin
.kotlin/

# Keystores
*.jks
*.keystore
# v2.1.0 (security): the production release keystore
# is NO LONGER committed. The previous keystore was
# scrubbed from git history on 2026-08-24 (see
# `git filter-repo --path app/baton-release.keystore
# --invert-paths`).
#
# v2.1.2: the `local.properties` escape hatch this
# comment described was never actually implemented —
# `app/build.gradle.kts` hard-coded
# `storeFile = file("kaavalan-note-release.keystore")`
# and read only the passwords from Gradle properties,
# so `assembleRelease` failed at `validateSigningRelease`
# on every clean checkout. It is implemented now; see
# `local.properties.example` for the four
# KAAVALAN_RELEASE_* keys and the keytool command.
# Without them the release build succeeds and emits
# UNSIGNED APKs (R8 and the splits still run), which is
# the correct mode for CI.
#
# The debug keystore stays ignored — it's regenerated
# locally for ad-hoc device installs only.

