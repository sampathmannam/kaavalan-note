<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- v2.0 Tier 2 (§2.7, §2.9): read the user's calendar to
         surface the "Brief me before a meeting" card and to
         suggest a calendar link when a capture is saved. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- v2.0 Tier 2 (§2.6): the morning brief notification fires
         at 9 AM via WorkManager's PeriodicWorkRequest.
         SCHEDULE_EXACT_ALARM, when granted, is what lets that
         land at exactly the user's chosen time rather than
         WorkManager's normal +/- window.

         v2.1.2 (release-integrity) correction: the "we request
         it from the Settings sheet" claim that used to be here
         was aspirational, not real — nothing in this codebase
         calls AlarmManager#canScheduleExactAlarms() or launches
         ACTION_REQUEST_SCHEDULE_EXACT_ALARM (verified by search;
         see MorningBriefWorker's own doc comment for the honest
         version: "the user must grant it manually on Android
         14+; if they don't, WorkManager's PeriodicWorkRequest
         still fires, just at a less precise time"). There is no
         silent ask because there is no ask at all yet — the OS
         alarms-and-reminders settings screen is the only place a
         user can currently grant this. Building the in-app
         request flow the old comment described is tracked as
         follow-up work, not done here.

         v2.1.2 also removed the neighboring USE_EXACT_ALARM
         (nothing in the codebase referenced it — see git
         history) and demoted the 522 MissingTranslation entries
         that were burying real lint errors (see the `lint {}`
         block in app/build.gradle.kts). That's what surfaced
         this permission as a `ProtectedPermissions` finding.
         It's a lint false positive for this specific permission:
         SCHEDULE_EXACT_ALARM's real platform protectionLevel is
         "appop" (Android 13+; "normal|appop" on 12), which is
         why a regular third-party app can be granted it via the
         Settings toggle at all — true signature/privileged
         permissions are never user-grantable. tools:ignore below
         is scoped to this one line; every other ProtectedPermissions
         finding stays fatal. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:ignore="ProtectedPermissions" />

    <!-- v1.2: Android 11+ (API 30+) package visibility — declare
         which intents we resolve. Without this, resolveActivity
         returns null for: CalendarContract.ACTION_INSERT, share
         targets from other apps, and the camera intent. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- v2.0 (Hierarchy): outbound SMS dispatch -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <!-- v2.0 (Hierarchy): outbound WhatsApp dispatch -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- M1-T6: Calendar integration via CalendarContract.ACTION_INSERT.
         The system Calendar app handles the per-account picker; on
         API 33+ the WRITE_CALENDAR permission is NOT needed because
         the user picks the calendar in the system UI. The
         `maxSdkVersion=32` keeps the manifest clean for newer API
         levels and avoids the runtime permission dance. -->
    <uses-permission
        android:name="android.permission.WRITE_CALENDAR"
        android:maxSdkVersion="32" />

    <!-- M2-T2: photo capture. CAMERA is needed for the in-app
         camera; the M2-T2 plan also wires ML Kit OCR. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- M2-T4: voice capture. RECORD_AUDIO is the runtime mic
         permission; FOREGROUND_SERVICE_MICROPHONE is required on
         API 34+ for any foreground service that uses the
         microphone. The service uses foregroundServiceType=microphone
         (declared below) so the system can revoke it when the user
         doesn't expect it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- v2.0 (Hierarchy): contact sync -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:name=".KaavalanApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.KaavalanNote">

        <!-- M3-T2: disable WorkManager's default auto-init.
             KaavalanApplication provides a Configuration via
             Configuration.Provider; the manual init lives in
             com.kaavalan.note.data.work.WorkManagerInitializer. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.KaavalanNote">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- v2.1.0 (PM rating): the Google Drive OAuth
             callback. Google redirects to
             `kaavalan-note://oauth-callback?code=...` after the
             user signs in + grants the `drive.appdata`
             scope. The activity is a transparent
             overlay that catches the intent, extracts
             the code, and exchanges it for an access +
             refresh token. -->
        <activity
            android:name=".features.auth.OAuthCallbackActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="kaavalan-note"
                    android:host="oauth-callback" />
            </intent-filter>
        </activity>

        <!-- Tier 0.3: share target. The user picks Kaavalan note from
             another app's share sheet; the alias forwards the
             shared text (or the OCR'd text from a shared image)
             to MainActivity which opens the capture sheet
             pre-filled. singleInstance means a second share
             intent re-uses the existing activity; the
             translucent theme keeps the user from seeing a
             flash of the receiver. -->
        <activity-alias
            android:name=".features.capture.ShareReceiverActivity"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="@string/share_to_kaavalan"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.KaavalanNote.Translucent.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity-alias>

        <!-- M2-T2: FileProvider for the in-app camera. The system
             camera writes a JPEG to our cacheDir/captures/, we
             hand it a content:// URI scoped to this provider, then
             the FileProvider grants the camera read/write access
             without exposing the rest of the app's storage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Tier 0.2: quick-settings tile. The user adds Kaavalan note
             from the system shade; tapping fires the
             ACTION_QUICK_CAPTURE deep link into MainActivity.
             The META_DATA_ACTIVE_TILE flag is set so the
             service is only bound while the shade is open;
             a battery and privacy win for a fire-and-forget
             capture tile. -->
        <service
            android:name=".features.capture.KaavalanTileService"
            android:label="@string/tier0_tile_label"
            android:icon="@mipmap/ic_launcher"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- Tier 0.1: Glance home-screen / lock-screen widget.
             Same deep link as the tile (ACTION_QUICK_CAPTURE ->
             MainActivity). The receiver is a GlanceAppWidgetReceiver
             that wraps the KaavalanCaptureWidget Glance composable. -->
        <receiver
            android:name=".features.capture.KaavalanCaptureWidgetReceiver"
            android:exported="true"
            android:label="@string/tier0_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kaavalan_capture_widget_info" />
        </receiver>

        <!-- v1.9.10: the Quick Note widget (Tier 1.1). A
             single-tap capture button that opens a fullscreen
             Compose entry activity (QuickNoteActivity) instead of
             the main app. The widget itself is stateless in
             v1.9.10 — it re-renders on save and on the 30-min
             system tick. The activity is `exported="false"` so
             only the widget (running as the user) can launch it;
             the OS cannot launch it from a generic intent. -->
        <receiver
            android:name=".features.widget.KaavalanQuickNoteWidgetReceiver"
            android:exported="true"
            android:label="@string/quick_note_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kaavalan_quick_note_widget_info" />
        </receiver>

        <activity
            android:name=".features.widget.QuickNoteActivity"
            android:exported="false"
            android:theme="@style/Theme.KaavalanNote"
            android:windowSoftInputMode="adjustResize"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <!-- v1.9.0 (PROD-READINESS-P3-P2-#3): widget gallery expansion.
             The Today widget opens the Today screen and shows a
             small badge with the open-instruction count. The
             count is hard-coded to "—" in v1.9.0 (a v2.x wires the
             badge to the Room query that backs the Today screen).
             The receiver is the standard Glance receiver pattern. -->
        <receiver
            android:name=".features.widget.KaavalanTodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_today_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kaavalan_today_widget_info" />
        </receiver>

        <!-- v1.9.0 (PROD-READINESS-P3-P2-#3): widget gallery
             expansion. The Decay widget opens the Today screen
             and shows a small badge with the quiet-contacts
             count. Same "—" placeholder as the Today widget. -->
        <receiver
            android:name=".features.widget.KaavalanDecayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_decay_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kaavalan_decay_widget_info" />
        </receiver>

        <!-- v1.6.1: voice capture foreground service. The user
             taps the mic icon in the NoteBar; the service starts
             the system SpeechRecognizer (which does its own
             recording + transcription), and emits the transcript
             back to the activity via a ResultReceiver.
             (an Intent extra) so the capture sheet can pre-fill.
             foregroundServiceType=microphone is required on API 34+. -->
        <service
            android:name=".features.capture.VoiceCaptureService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
