<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.KaavalanNote" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/kaavalan_primary</item>
        <item name="android:windowBackground">@color/kaavalan_note_background</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/kaavalan_note_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <!-- Tier 0.3: the share-target activity has no UI. It
         inspects the inbound SEND intent, forwards the text
         (or OCR'd text from an image) to MainActivity, and
         finishes. A translucent theme means the user never
         sees a flash of the activity itself, only the
         MainActivity underneath. -->
    <style name="Theme.KaavalanNote.Translucent.NoDisplay" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
